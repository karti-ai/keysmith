[Unit]
Description=Keysmith Q3 Max local control surface
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/keysmith
Environment=KEYSMITH_WEB_DIR=%h/.local/share/keysmith/apps/web/dist
ExecStart=%h/.local/share/keysmith/target/release/keysmith-server
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
